{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Template Builder",
  "version": "0.1.0",
  "identifier": "io.github.simao-pereira-gomes.template-builder",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Template Builder",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../vscode-extension/icons/atomize-product.png"]
  }
}
