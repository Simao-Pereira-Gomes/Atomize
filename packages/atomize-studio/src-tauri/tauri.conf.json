{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atomize Studio",
  "version": "0.1.1",
  "identifier": "io.github.simao-pereira-gomes.atomize-studio",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atomize Studio",
        "width": 1440,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/atomize-sidecar", "binaries/atomize-copilot"],
    "resources": {
      "../../atomize-core/catalog": "catalog"
    }
  }
}
