{
  "name": "@sppg2001/atomize-studio",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run sidecar:stage && tauri dev",
    "build": "bun run sidecar:stage && tauri build",
    "sidecar:stage": "bun run ../atomize-sidecar/src/stage-for-tauri.ts",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "bunx biome check --max-diagnostics 100",
    "lint:fix": "bunx biome check --fix --max-diagnostics 100"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@sppg2001/atomize-schema": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "solid-js": "^1.9.15",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  }
}
