{
	"name": "atomize",
	"displayName": "Atomize",
	"description": "VS Code extension for Atomize — generate tasks from YAML templates",
	"version": "0.0.1",
	"publisher": "sppg2001",
	"private": true,
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": ["Other"],
	"extensionPack": ["redhat.vscode-yaml"],
	"activationEvents": ["onStartupFinished"],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "atomize-yaml",
				"aliases": ["Atomize YAML"],
				"extensions": [".atomize.yaml", ".atomize.yml"],
				"firstLine": "^#\\s*atomize-yaml",
				"icon": {
					"light": "./icons/yaml-light.svg",
					"dark": "./icons/yaml-dark.svg"
				}
			}
		],
		"yamlValidation": [
			{
				"fileMatch": ["**/*.atomize.yaml", "**/*.atomize.yml"],
				"url": "./schemas/atomize-template.schema.json"
			}
		],
		"commands": [
			{
				"command": "atomize.validate",
				"title": "Atomize: Validate",
				"category": "Atomize"
			},
			{
				"command": "atomize.preview",
				"title": "Atomize: Preview (Mock)",
				"category": "Atomize"
			}
		],
		"grammars": [
			{
				"language": "atomize-yaml",
				"scopeName": "source.atomize-yaml",
				"path": "./syntaxes/atomize-yaml.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "atomize-yaml",
				"path": "./snippets/atomize-yaml.code-snippets"
			}
		]
	},
	"scripts": {
		"prebuild": "bun run --cwd ../.. generate-schema",
		"build": "bun esbuild.mjs",
		"package": "vsce package --no-dependencies",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^2.24.0",
		"esbuild": "^0.20.0",
		"typescript": "^6.0.3"
	}
}
