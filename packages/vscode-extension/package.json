{
	"name": "atomize",
	"displayName": "Atomize",
	"description": "VS Code extension for Atomize — generate tasks from YAML templates",
	"version": "0.0.1",
	"publisher": "sppg2001",
	"private": true,
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": ["Other"],
	"extensionPack": ["redhat.vscode-yaml"],
	"activationEvents": ["onStartupFinished"],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "atomize-yaml",
				"aliases": ["Atomize YAML"],
				"filenamePatterns": [
					"**/templates/**/*.yml",
					"**/templates/**/*.yaml",
					"**/atomize/**/*.yml",
					"**/atomize/**/*.yaml",
					"**/*.atomize.yml",
					"**/*.atomize.yaml"
				],
				"firstLine": "^#\\s*atomize-yaml"
			}
		]
	},
	"scripts": {
		"prebuild": "bun run --cwd ../.. generate-schema",
		"build": "bun esbuild.mjs",
		"package": "vsce package --no-dependencies",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^2.24.0",
		"esbuild": "^0.20.0",
		"typescript": "^6.0.3"
	}
}
