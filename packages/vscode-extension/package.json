{
	"name": "atomize",
	"displayName": "Atomize",
	"description": "VS Code extension for Atomize: generate tasks from YAML templates",
	"version": "0.5.4",
	"publisher": "atomize",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Simao-Pereira-Gomes/atomize",
		"directory": "packages/vscode-extension"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"icon": "icons/atomize-product.png",
	"categories": [
		"Programming Languages",
		"Snippets",
		"Linters",
		"Other"
	],
	"extensionPack": ["redhat.vscode-yaml"],
	"activationEvents": ["onStartupFinished"],
	"main": "./dist/extension.js",
	"contributes": {
		"configurationDefaults": {
			"files.associations": {
				"*.atomize.yaml": "yaml",
				"*.atomize.yml": "yaml"
			}
		},
		"configuration": {
			"title": "Atomize",
			"properties": {
				"atomize.defaultProfile": {
					"type": "string",
					"default": "",
					"scope": "resource",
					"description": "Name of the Connection Profile to pre-select in the Validate, Generate, and Live Preview pickers. If blank or the name does not match a known profile, the picker pre-selects the profile marked Set as default in Atomize: Manage Profiles. Safe to commit in .vscode/settings.json, since it stores a name, not a credential."
				},
				"atomize.ai.model": {
					"type": "string",
					"default": "auto",
					"markdownDescription": "The GitHub Copilot model family Atomize uses for AI drafting, such as `gpt-4o` or `claude-sonnet-4`. Leave as `auto` to use the available Copilot model with the largest input limit, which grounded requests need. Uses the Copilot account you're signed in to in VS Code; Atomize stores no token."
				},
				"atomize.schemaReference.openMode": {
					"type": "string",
					"enum": ["beside", "editor"],
					"enumDescriptions": [
						"Open in a wider side-by-side editor group.",
						"Open as a regular tab in the current text editor group."
					],
					"default": "editor",
					"scope": "window",
					"description": "Where Open Schema Reference opens the reference. Changes apply the next time you run the command."
				},
				"atomize.previewLayout": {
					"type": "string",
					"enum": ["default", "compact"],
					"default": "default",
					"description": "Layout for the Mock Preview Panel. 'default' shows KPI tiles and per-task estimation bars; 'compact' shows a summary table."
				}
			}
		},
		"languages": [
			{
				"id": "atomize-yaml",
				"aliases": ["Atomize YAML"],
				"icon": {
					"light": "./icons/yaml-light.svg",
					"dark": "./icons/yaml-dark.svg"
				}
			}
		],
		"commands": [
			{
				"command": "atomize.validate",
				"title": "Validate",
				"category": "Atomize"
			},
			{
				"command": "atomize.preview",
				"title": "Preview (Mock)",
				"category": "Atomize"
			},
			{
				"command": "atomize.livePreview",
				"title": "Preview (Live)",
				"category": "Atomize"
			},
			{
				"command": "atomize.generate",
				"title": "Generate",
				"category": "Atomize"
			},
			{
				"command": "atomize.manageProfiles",
				"title": "Manage Profiles",
				"category": "Atomize"
			},
			{
				"command": "atomize.openSettings",
				"title": "Open Settings",
				"category": "Atomize"
			},
			{
				"command": "atomize.browseFields",
				"title": "Browse Fields",
				"category": "Atomize"
			},
			{
				"command": "atomize.browseQueries",
				"title": "Browse Queries",
				"category": "Atomize"
			},
			{
				"command": "atomize.showResolvedTemplate",
				"title": "Show Effective Template",
				"category": "Atomize"
			},
			{
				"command": "atomize.browseCatalog",
				"title": "Browse Catalog",
				"category": "Atomize"
			},
			{
				"command": "atomize.installToCatalog",
				"title": "Install to Catalog",
				"category": "Atomize"
			},
			{
				"command": "atomize.draftTemplateWithAI",
				"title": "Draft Template with AI",
				"category": "Atomize"
			},
			{
				"command": "atomize.improveTemplateWithAI",
				"title": "Improve Template with AI",
				"category": "Atomize"
			},
			{
				"command": "atomize.acceptImprovement",
				"title": "Accept Improvement",
				"category": "Atomize",
				"icon": "$(check)"
			},
			{
				"command": "atomize.saveImprovementAsNew",
				"title": "Save Improvement as New Template",
				"category": "Atomize",
				"icon": "$(save-as)"
			},
			{
				"command": "atomize.rejectImprovement",
				"title": "Reject Improvement",
				"category": "Atomize",
				"icon": "$(close)"
			},
			{
				"command": "atomize.openSchemaReference",
				"title": "Open Schema Reference",
				"category": "Atomize"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "atomize.acceptImprovement",
					"when": "resourceScheme == untitled && resourcePath in atomize.improvementProposals",
					"group": "navigation@1"
				},
				{
					"command": "atomize.saveImprovementAsNew",
					"when": "resourceScheme == untitled && resourcePath in atomize.improvementProposals",
					"group": "navigation@2"
				},
				{
					"command": "atomize.rejectImprovement",
					"when": "resourceScheme == untitled && resourcePath in atomize.improvementProposals",
					"group": "navigation@3"
				}
			],
			"commandPalette": [
				{
					"command": "atomize.acceptImprovement",
					"when": "resourceScheme == untitled && resourcePath in atomize.improvementProposals"
				},
				{
					"command": "atomize.saveImprovementAsNew",
					"when": "resourceScheme == untitled && resourcePath in atomize.improvementProposals"
				},
				{
					"command": "atomize.rejectImprovement",
					"when": "resourceScheme == untitled && resourcePath in atomize.improvementProposals"
				}
			],
			"editor/context": [
				{
					"command": "atomize.openSchemaReference",
					"when": "resourcePath in atomize.schemaDocumentPaths",
					"group": "atomize@1"
				}
			]
		},
		"grammars": [
			{
				"language": "atomize-yaml",
				"scopeName": "source.atomize-yaml",
				"path": "./syntaxes/atomize-yaml.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "yaml",
				"path": "./snippets/atomize-yaml.code-snippets"
			}
		]
	},
	"scripts": {
		"prebuild": "bun run --cwd ../cli generate-schema",
		"build": "bun esbuild.mjs && vite build --config vite.webview.config.mts",
		"package": "vsce package --no-dependencies --baseContentUrl https://github.com/Simao-Pereira-Gomes/atomize/blob/HEAD/packages/vscode-extension --baseImagesUrl https://github.com/Simao-Pereira-Gomes/atomize/raw/HEAD/packages/vscode-extension",
		"verify:readme-images": "node scripts/verify-readme-images.mjs",
		"typecheck": "tsc --noEmit && tsc --noEmit -p webview/tsconfig.json",
		"lint": "bunx biome check --max-diagnostics 100",
		"lint:fix": "bunx biome check --fix --max-diagnostics 100"
	},
	"dependencies": {
		"@sppg2001/atomize-core": "workspace:*",
		"@sppg2001/atomize-schema-reference": "workspace:*",
		"solid-js": "^1.9.17",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@types/node": "^26.5.1",
		"@types/vscode": "^1.90.0",
		"@vscode/vsce": "^4.0.0",
		"bun-types": "^1.4.2",
		"esbuild": "^0.28.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vite-plugin-solid": "^2.11.14"
	}
}
