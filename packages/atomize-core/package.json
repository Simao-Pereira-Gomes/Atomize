{
  "name": "@sppg2001/atomize-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core/*": "./src/core/*.ts",
    "./platforms/*": "./src/platforms/*.ts",
    "./services/*": "./src/services/*.ts",
    "./templates/*": "./src/templates/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@sppg2001/atomize-schema": "workspace:*",
    "azure-devops-node-api": "^15.1.2",
    "ts-pattern": "^5.9.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
