{
  "name": "@sppg2001/atomize-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run typecheck && bun build ./src/index.ts --outdir ./dist --target node --format esm --external @github/copilot-sdk",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@github/copilot": "^1.0.79",
    "@github/copilot-sdk": "^1.0.9"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "^6.0.3"
  }
}
