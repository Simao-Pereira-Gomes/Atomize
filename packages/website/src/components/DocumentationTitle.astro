---
import PageTitle from "@astrojs/starlight/components/PageTitle.astro";
const category = Astro.url.pathname.startsWith("/reference/templates/") ? "Templates" : Astro.url.pathname.startsWith("/studio/") ? "Atomize Studio" : "Documentation";
---
<p class="documentation-eyebrow">{category}</p>
<PageTitle />
<p class="development-notice" data-pagefind-ignore><span aria-hidden="true"></span>Development docs · main. Your installed version may differ.</p>
