<atomize-sidebar-toggle>
  <button type="button" aria-controls="starlight__sidebar" aria-expanded="true" aria-label="Collapse navigation" title="Collapse navigation">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M9 4v16" />
      <path class="sidebar-direction" d="m16 9-3 3 3 3" />
    </svg>
  </button>
</atomize-sidebar-toggle>

<script>
  class SidebarToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      if (!button) return;
      const update = () => {
        const collapsed = document.documentElement.hasAttribute("data-sidebar-collapsed");
        const label = collapsed ? "Expand navigation" : "Collapse navigation";
        button.setAttribute("aria-expanded", String(!collapsed));
        button.setAttribute("aria-label", label);
        button.title = label;
      };
      update();
      button.addEventListener("click", () => {
        const collapsed = document.documentElement.toggleAttribute("data-sidebar-collapsed");
        try { localStorage.setItem("atomize-sidebar-collapsed", String(collapsed)); } catch {}
        update();
      });
    }
  }
  if (!customElements.get("atomize-sidebar-toggle")) customElements.define("atomize-sidebar-toggle", SidebarToggle);
</script>

<style>
  atomize-sidebar-toggle { display: none; flex-shrink: 0; }
  button { display: grid; place-items: center; width: 2rem; height: 2rem; padding: 0; border: 1px solid var(--sl-color-hairline-light); border-radius: 6px; background: transparent; color: var(--sl-color-gray-2); cursor: pointer; }
  button:hover { background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); }
  button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  [aria-expanded="false"] .sidebar-direction { transform: rotate(180deg); transform-origin: 14.5px 12px; }
  @media (min-width: 50rem) { atomize-sidebar-toggle:defined { display: block; } }
</style>
