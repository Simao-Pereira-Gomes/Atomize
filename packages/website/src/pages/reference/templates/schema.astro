---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { buildSchemaTrees } from "@sppg2001/atomize-schema-reference";
import schema from "@sppg2001/atomize-schema-reference/schema.json";
import { WebsiteSchemaReference } from "../../../components/WebsiteSchemaReference";
import "@sppg2001/atomize-schema-reference/styles.css";
import { versionLabel } from "../../../lib/build-info";

const trees = buildSchemaTrees(schema);
---
<StarlightPage frontmatter={{
  title: "Schema Reference",
  description: "Browse the fields, types and constraints of Atomize Templates and Mixins.",
  editUrl: false,
  tableOfContents: false,
}}>
  <p>Everything you can put in an Atomize YAML File. Browse Templates or Mixins, search for a field, and follow its link to the Template Reference for behaviour and examples.</p>
  <!-- Keep article typography from styling the shared viewer's interactive controls. -->
  <div class="atomize-website-schema not-content">
    <WebsiteSchemaReference trees={trees} versionLabel={versionLabel} client:load />
  </div>
</StarlightPage>

<style is:global>
  html:has(.atomize-website-schema) { --sl-content-width: 64rem; }
  html:has(.atomize-website-schema) main > .content-panel:first-child { padding-bottom: 1rem; }
  html:has(.atomize-website-schema) .sl-markdown-content > p { margin: 0; color: var(--sl-color-gray-2); font-size: 1rem; line-height: 1.6; }
  html:has(.atomize-website-schema) main > .content-panel > .sl-container > footer { display: none; }
  .atomize-website-schema { margin-top: 1.5rem; }
  .atomize-website-schema .schema-reference { font-family: var(--sl-font, var(--sl-font-system)); font-size: 1rem; background: transparent; }
  .atomize-website-schema .schema-reference-breadcrumb, .atomize-website-schema .schema-reference-intro { display: none; }
  .atomize-website-schema .schema-reference-layout { max-width: none; }
  .atomize-website-schema .schema-reference-content { padding: 0; }
  .atomize-website-schema .schema-reference-section-heading { margin-top: 0; }
  .atomize-website-schema .schema-reference-fields > article, .atomize-website-schema .schema-reference-nested details { scroll-margin-top: 1rem; }
  .atomize-website-schema .schema-reference-description { font-size: .9375rem; }

  /* The sidebar holds the field index here; collapsed, it keeps only the way back to all documentation. */
  @media (min-width: 50rem) {
    html:has(.atomize-website-schema)[data-sidebar-collapsed] .sidebar-content > .documentation-rail { display: none; }
    html:has(.atomize-website-schema)[data-sidebar-collapsed] .sidebar-content > .schema-reference-back { display: block; }
    html:has(.atomize-website-schema)[data-sidebar-collapsed] .schema-reference-back a { justify-content: center; width: 2.75rem; height: 2.75rem; margin: 0; align-items: center; border-radius: .5rem; font-size: 1.125rem; }
    html:has(.atomize-website-schema)[data-sidebar-collapsed] .schema-reference-back a:hover { background: var(--sl-color-gray-6); }
    html:has(.atomize-website-schema)[data-sidebar-collapsed] .schema-reference-back-label { display: none; position: fixed; left: 4.5rem; z-index: var(--sl-z-index-menu); padding: .4rem .65rem; background: var(--sl-color-bg-nav); color: var(--sl-color-text); border: 1px solid var(--sl-color-hairline-light); border-radius: 5px; box-shadow: var(--sl-shadow-sm); font-size: .875rem; white-space: nowrap; pointer-events: none; }
    html:has(.atomize-website-schema)[data-sidebar-collapsed] .schema-reference-back a:is(:hover, :focus-visible) .schema-reference-back-label { display: block; }
  }

  /* The field navigation replaces the site's page list once the viewer has moved it into the sidebar. */
  html:has(.schema-reference-detached-navigation) .sidebar-content > sl-sidebar-state-persist { display: none; }
  .sidebar-content > .schema-reference-back { order: -2; }
  .sidebar-content > .schema-reference-detached-navigation { order: -1; font-family: var(--sl-font, var(--sl-font-system)); font-size: .9375rem; }
  .schema-reference-back a { display: inline-flex; gap: .4rem; margin-bottom: 1.25rem; color: var(--sl-color-gray-2); font-size: .875rem; text-decoration: none; }
  .schema-reference-back a:hover { color: var(--sl-color-text-accent); }
  .schema-reference-detached-navigation .schema-reference-sidebar > .schema-reference-eyebrow { display: none; }
  .schema-reference-detached-navigation .schema-reference-tabs { margin-top: 0; }
  .schema-reference-detached-navigation .schema-reference-navigation code, .schema-reference-detached-navigation .schema-reference-search input { font-size: .875rem; }
</style>

<script>
  // On narrow screens the field navigation lives in the mobile menu: close it once a field is chosen.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest(".schema-reference-detached-navigation .schema-reference-navigation button")) return;
    const menu = document.getElementById("starlight__sidebar");
    if (menu?.matches(":popover-open")) menu.hidePopover();
  });
</script>
