---
import { schemaRoute } from "../lib/documentation";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Schema Reference has moved · Atomize</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(schemaRoute, Astro.site)} />
    <script is:inline define:vars={{ schemaRoute }}>
      window.location.replace(schemaRoute + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${schemaRoute}`} /></noscript>
  </head>
  <body data-pagefind-ignore="all"><p>The Schema Reference has moved. <a href={schemaRoute}>Open Schema Reference</a>.</p></body>
</html>
