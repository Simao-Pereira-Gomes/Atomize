---
import { execFileSync } from "node:child_process";
import { buildSchemaTrees } from "@sppg2001/atomize-schema-reference";
import schema from "@sppg2001/atomize-schema-reference/schema.json";
import { SchemaReference } from "@sppg2001/atomize-schema-reference/viewer";
import "@sppg2001/atomize-schema-reference/styles.css";
import logo from "../../../vscode-extension/icons/atomize-product.svg?url";
import { ThemeToggle } from "../components/ThemeToggle";

const trees = buildSchemaTrees(schema);
const commit = execFileSync("git", ["rev-parse", "--short", "HEAD"], { encoding: "utf8" }).trim();
const versionLabel = `main @ ${commit} · ${new Date().toISOString().slice(0, 10)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem("atomize-theme"); } catch {}
        const theme = saved === "light" || saved === "dark" ? saved : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <meta name="description" content="Browse the fields, types and constraints of Atomize Templates and Mixins." />
    <title>Schema Reference · Atomize</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/schema"><img src={logo} width="26" height="26" alt="" />atomize<span>/ docs</span></a>
      <nav aria-label="Documentation"><span aria-current="page">Schema Reference</span><a href="https://github.com/Simao-Pereira-Gomes/Atomize/blob/main/docs/Template-Reference.md">Template Reference ↗</a></nav>
      <span class="site-version"><i aria-hidden="true"></i>main · development</span>
      <ThemeToggle client:load />
    </header>
    <main>
      <SchemaReference trees={trees} versionLabel={versionLabel} notice="You’re reading the development schema on main. The Schema Reference inside Atomize Studio and the VS Code extension matches your installed version." client:load />
    </main>
  </body>
</html>
<style is:global>
  :root { color-scheme: light dark; background: #fff; color: #282d37; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  body { margin: 0; }
  .site-header { min-height: 72px; box-sizing: border-box; border-bottom: 1px solid #e5e5ed; padding: 18px 36px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 60px; }
  .site-header a { color: inherit; text-decoration: none; }
  .site-brand { display: flex; gap: 9px; align-items: center; font-weight: 750; font-size: 21px; letter-spacing: -.9px; }
  .site-brand span { font-size: 14px; font-weight: 400; letter-spacing: 0; color: #626b7b; margin-left: 9px; }
  .site-header nav { display: flex; flex-wrap: wrap; gap: 22px; font-size: 12px; color: #626b7b; }
  .site-header nav > span { color: #6852ac; }
  .site-header a:focus-visible { outline: 2px solid #6852ac; outline-offset: 4px; border-radius: 4px; }
  .site-version { margin-left: auto; font: 11px ui-monospace, monospace; color: #626b7b; display: flex; align-items: center; gap: 8px; }
  .site-version i { width: 6px; height: 6px; border-radius: 50%; background: #69816e; }
  .theme-toggle { display: flex; gap: 8px; align-items: center; padding: 7px 10px; border: 1px solid #e5e5ed; border-radius: 6px; background: transparent; color: inherit; font: inherit; font-size: 12px; cursor: pointer; }
  .theme-toggle:hover { background: #f7f7fa; }
  .theme-toggle:focus-visible { outline: 2px solid #6852ac; outline-offset: 3px; }
  @media (max-width: 760px) { .site-header { padding: 18px 24px; justify-content: space-between; gap: 14px; } .site-brand span, .site-version { display: none; } .site-header nav { font-size: 11px; gap: 12px; } }
  :root[data-theme="dark"] { background: #17191f; color: #edeaf3; }
  :root[data-theme="dark"] .site-header, :root[data-theme="dark"] .theme-toggle { border-color: #343641; }
  :root[data-theme="dark"] .site-header nav, :root[data-theme="dark"] .site-brand span, :root[data-theme="dark"] .site-version { color: #b2b7c7; }
  :root[data-theme="dark"] .site-header nav > span { color: #c3acef; }
  :root[data-theme="dark"] .theme-toggle:hover { background: #22252e; }
</style>
